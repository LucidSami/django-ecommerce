# Django Core Settings
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=False

# Allowed Hosts & CSRF (comma-separated for multiple)
# NOTE: If deploying on Render, RENDER_EXTERNAL_HOSTNAME is automatically added,
# so you only need to add custom domains here.
ALLOWED_HOSTS=store.example.com
CSRF_TRUSTED_ORIGINS=https://store.example.com

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:password@localhost:5432/kenakata

# Cloudinary Media Storage (For uploading product images, etc.)
# Get this from your Cloudinary Dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://my_key:my_secret@my_cloud_name

# Email Settings (SMTP)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
