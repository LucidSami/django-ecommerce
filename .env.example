# Django Core Settings
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=False

# Allowed Hosts & CSRF (comma-separated for multiple)
ALLOWED_HOSTS=example.railway.app,store.example.com
CSRF_TRUSTED_ORIGINS=https://example.railway.app,https://store.example.com

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:password@localhost:5432/kenakata

# Email Settings (SMTP)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
